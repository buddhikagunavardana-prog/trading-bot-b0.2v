# ==============================================================================
# Production Environment Variables Blueprint (.env.production)
# DO NOT COMMIT REAL PRODUCTION KEYS TO VERSION CONTROL
# ==============================================================================

# Server Runtime Settings
NODE_ENV=production
PORT=8080
LOG_LEVEL=info
SERVICE_NAME=trading-engine-service

# Database Configuration (PostgreSQL / TimescaleDB)
POSTGRES_USER=trading_admin
POSTGRES_PASSWORD=YOUR_STRONG_DB_PASSWORD
POSTGRES_DB=trading_platform
DATABASE_URL=postgres://trading_admin:YOUR_STRONG_DB_PASSWORD@localhost:5432/trading_platform

# Cache & Redis Pub/Sub
REDIS_URL=redis://localhost:6379

# Live Exchange API Credentials
EXCHANGE_API_KEY=YOUR_PROD_EXCHANGE_API_KEY
EXCHANGE_API_SECRET=YOUR_PROD_EXCHANGE_SECRET_KEY
EXCHANGE_PASSPHRASE=YOUR_PROD_EXCHANGE_PASSPHRASE

# Sentry & Production Monitoring
SENTRY_DSN=https://your_sentry_dsn_key@o0.ingest.sentry.io/0
ENABLE_SENTRY=true

# Security & Rate Limiting
JWT_SECRET=YOUR_SUPER_SECURE_JWT_SECRET_KEY_2026
MAX_REQUESTS_PER_MINUTE=100
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
