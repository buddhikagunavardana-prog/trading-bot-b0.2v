# ==============================================================================
# Production Environment Configuration Template
# Copy this file to .env and populate with your actual production secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# Server & Application Configuration
# ------------------------------------------------------------------------------
ENVIRONMENT=production
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
SECRET_KEY=your_random_production_secret_key_here

# ------------------------------------------------------------------------------
# Exchange API Credentials
# ------------------------------------------------------------------------------
# Binance API (Futures / Spot)
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET_KEY=your_binance_secret_key_here
BINANCE_TESTNET=false

# Bybit API
BYBIT_API_KEY=your_bybit_api_key_here
BYBIT_SECRET_KEY=your_bybit_secret_key_here
BYBIT_TESTNET=false

# OKX API
OKX_API_KEY=your_okx_api_key_here
OKX_SECRET_KEY=your_okx_secret_key_here
OKX_PASSPHRASE=your_okx_passphrase_here

# Bitget API
BITGET_API_KEY=your_bitget_api_key_here
BITGET_SECRET_KEY=your_bitget_secret_key_here
BITGET_PASSPHRASE=your_bitget_passphrase_here

# ------------------------------------------------------------------------------
# Telegram Bot Configuration & Alerts
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_CHAT_ID=987654321
TELEGRAM_ALERTS_ENABLED=true
TELEGRAM_TRADE_OPEN_ALERTS=true
TELEGRAM_TRADE_CLOSE_ALERTS=true
TELEGRAM_SYSTEM_STATUS_ALERTS=true

# ------------------------------------------------------------------------------
# AI Engine Configuration
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
# Default SQLite string: sqlite:///./trading_bot.db
# PostgreSQL string: postgresql://user:password@localhost:5432/trading_db
DATABASE_URL=sqlite:///./trading_bot.db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password
POSTGRES_DB=trading_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# Monitoring & Error Tracking
# ------------------------------------------------------------------------------
SENTRY_DSN=https://your_sentry_dsn_here@ingest.sentry.io/0
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=1.0
